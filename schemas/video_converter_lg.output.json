{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "video_converter_lg — output",
  "oneOf": [
    {
      "type": "object",
      "required": ["success", "data"],
      "additionalProperties": false,
      "properties": {
        "success": { "type": "boolean", "enum": [true] },
        "data": {
          "type": "object",
          "required": ["input_path", "output_path", "output_format", "elapsed_seconds"],
          "properties": {
            "input_path":  { "type": "string", "description": "Resolved absolute path of the source file" },
            "output_path": { "type": "string", "description": "Resolved absolute path of the output MP4" },
            "output_format": {
              "type": "object",
              "properties": {
                "container":      { "type": "string" },
                "video_codec":    { "type": "string" },
                "audio_codec":    { "type": "string" },
                "max_resolution": { "type": "string" },
                "max_fps":        { "type": "integer" },
                "crf":            { "type": "integer" },
                "preset":         { "type": "string" }
              }
            },
            "source_info": {
              "type": "object",
              "properties": {
                "width":       { "type": ["integer", "null"] },
                "height":      { "type": ["integer", "null"] },
                "fps":         { "type": ["number", "null"] },
                "duration":    { "type": ["number", "null"], "description": "Duration in seconds" },
                "video_codec": { "type": ["string", "null"] },
                "audio_codec": { "type": ["string", "null"] }
              }
            },
            "input_size_bytes":  { "type": "integer", "minimum": 0 },
            "input_size_mb":     { "type": "number",  "minimum": 0 },
            "output_size_bytes": { "type": "integer", "minimum": 0 },
            "output_size_mb":    { "type": "number",  "minimum": 0 },
            "elapsed_seconds":   { "type": "number",  "minimum": 0 }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["success", "error"],
      "additionalProperties": false,
      "properties": {
        "success": { "type": "boolean", "enum": [false] },
        "error":   { "type": "string" }
      }
    }
  ]
}
