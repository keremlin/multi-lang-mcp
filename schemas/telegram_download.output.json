{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "telegram_download output",
  "oneOf": [
    {
      "title": "Success",
      "type": "object",
      "required": ["success", "data"],
      "additionalProperties": false,
      "properties": {
        "success": { "type": "boolean", "enum": [true] },
        "data": {
          "type": "object",
          "required": ["channel", "channel_title", "output_dir", "downloaded_count", "skipped_count", "files"],
          "properties": {
            "channel": { "type": "string" },
            "channel_title": { "type": "string" },
            "output_dir": { "type": "string" },
            "downloaded_count": { "type": "integer" },
            "skipped_count": { "type": "integer" },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["message_id", "filename", "path", "mime_type", "size_bytes", "size_mb"],
                "properties": {
                  "message_id": { "type": "integer" },
                  "filename": { "type": "string" },
                  "path": { "type": "string" },
                  "mime_type": { "type": "string" },
                  "size_bytes": { "type": "integer" },
                  "size_mb": { "type": "number" },
                  "date": { "type": ["string", "null"] }
                }
              }
            }
          }
        }
      }
    },
    {
      "title": "Error",
      "type": "object",
      "required": ["success", "error"],
      "additionalProperties": false,
      "properties": {
        "success": { "type": "boolean", "enum": [false] },
        "error": { "type": "string" }
      }
    }
  ]
}
