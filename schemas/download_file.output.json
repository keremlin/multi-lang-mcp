{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "download_file — output",
  "oneOf": [
    {
      "type": "object",
      "required": ["success", "data"],
      "additionalProperties": false,
      "properties": {
        "success": { "type": "boolean", "enum": [true] },
        "data": {
          "type": "object",
          "required": ["url", "saved_to", "bytes_downloaded", "total_bytes", "progress_percent", "progress_milestones"],
          "properties": {
            "url":                 { "type": "string" },
            "saved_to":            { "type": "string", "description": "Absolute path where the file was saved" },
            "bytes_downloaded":    { "type": "integer", "minimum": 0 },
            "total_bytes":         { "type": ["integer", "null"], "minimum": 0, "description": "null when the server did not send Content-Length" },
            "progress_percent":    { "type": "number", "minimum": 0, "maximum": 100 },
            "progress_milestones": {
              "type": "array",
              "items": { "type": "integer", "enum": [25, 50, 75, 100] },
              "description": "25% increment checkpoints reached during the download"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["success", "error"],
      "additionalProperties": false,
      "properties": {
        "success": { "type": "boolean", "enum": [false] },
        "error":   { "type": "string" }
      }
    }
  ]
}
