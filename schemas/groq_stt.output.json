{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "groq_stt — output",
  "oneOf": [
    {
      "type": "object",
      "required": ["success", "data"],
      "additionalProperties": false,
      "properties": {
        "success": { "type": "boolean", "enum": [true] },
        "data": {
          "type": "object",
          "required": ["transcript", "language_code", "model", "audio_path", "file_size_bytes"],
          "properties": {
            "transcript":      { "type": "string", "description": "Full transcription of the audio" },
            "language_code":   { "type": "string" },
            "model":           { "type": "string" },
            "audio_path":      { "type": "string", "description": "Absolute path of the input audio file" },
            "file_size_bytes": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["success", "error"],
      "additionalProperties": false,
      "properties": {
        "success": { "type": "boolean", "enum": [false] },
        "error":   { "type": "string" }
      }
    }
  ]
}
