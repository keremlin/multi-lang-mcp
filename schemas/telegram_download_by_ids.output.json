{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "telegram_download_by_ids output",
  "oneOf": [
    {
      "type": "object",
      "required": ["success", "data"],
      "properties": {
        "success": { "const": true },
        "data": {
          "type": "object",
          "required": ["channel", "channel_title", "output_dir", "downloaded_count", "skipped_count", "failed_count", "files", "failed"],
          "properties": {
            "channel": { "type": "string" },
            "channel_title": { "type": "string" },
            "output_dir": { "type": "string" },
            "downloaded_count": { "type": "integer" },
            "skipped_count": { "type": "integer" },
            "failed_count": { "type": "integer" },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "message_id": { "type": "integer" },
                  "filename": { "type": "string" },
                  "path": { "type": "string" },
                  "mime_type": { "type": "string" },
                  "size_bytes": { "type": "integer" },
                  "size_mb": { "type": "number" },
                  "date": { "type": ["string", "null"] }
                }
              }
            },
            "failed": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "message_id": { "type": "integer" },
                  "error": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["success", "error"],
      "properties": {
        "success": { "const": false },
        "error": { "type": "string" }
      }
    }
  ]
}