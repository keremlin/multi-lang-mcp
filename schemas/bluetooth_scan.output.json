{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "type": "object",
      "required": ["success", "data"],
      "properties": {
        "success": { "type": "boolean", "enum": [true] },
        "data": {
          "type": "object",
          "required": ["count", "devices"],
          "properties": {
            "count": { "type": "integer" },
            "devices": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name":      { "type": "string" },
                  "address":   { "type": "string" },
                  "connected": { "type": "boolean" },
                  "paired":    { "type": "boolean" },
                  "signal":    { "type": ["integer", "null"] }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["success", "error"],
      "properties": {
        "success": { "type": "boolean", "enum": [false] },
        "error":   { "type": "string" }
      }
    }
  ]
}
