{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "windows_services — output",
  "oneOf": [
    {
      "type": "object",
      "required": ["success", "data"],
      "additionalProperties": false,
      "properties": {
        "success": { "type": "boolean", "enum": [true] },
        "data": {
          "type": "object",
          "required": ["services"],
          "properties": {
            "services": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "displayName", "status"],
                "properties": {
                  "name":        { "type": "string" },
                  "displayName": { "type": "string" },
                  "status":      { "type": "string", "enum": ["Running", "Stopped", "Paused", "StartPending", "StopPending"] }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["success", "error"],
      "additionalProperties": false,
      "properties": {
        "success": { "type": "boolean", "enum": [false] },
        "error":   { "type": "string" }
      }
    }
  ]
}
