{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "youtube_downloader_lg — output",
  "oneOf": [
    {
      "type": "object",
      "required": ["success", "data"],
      "additionalProperties": false,
      "properties": {
        "success": { "type": "boolean", "enum": [true] },
        "data": {
          "type": "object",
          "required": ["title", "url", "saved_to", "file_size_bytes", "file_size_mb", "output_format", "elapsed_seconds"],
          "properties": {
            "title":            { "type": "string" },
            "url":              { "type": "string" },
            "saved_to":         { "type": "string", "description": "Absolute path of the saved MP4 file" },
            "file_size_bytes":  { "type": "integer", "minimum": 0 },
            "file_size_mb":     { "type": "number",  "minimum": 0 },
            "output_format": {
              "type": "object",
              "properties": {
                "container":      { "type": "string" },
                "video_codec":    { "type": "string" },
                "audio_codec":    { "type": "string" },
                "max_resolution": { "type": "string" },
                "crf":            { "type": "integer" },
                "preset":         { "type": "string" }
              }
            },
            "duration_seconds": { "type": ["integer", "null"] },
            "uploader":         { "type": "string" },
            "elapsed_seconds":  { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["success", "error"],
      "additionalProperties": false,
      "properties": {
        "success": { "type": "boolean", "enum": [false] },
        "error":   { "type": "string" }
      }
    }
  ]
}
