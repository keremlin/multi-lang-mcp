# Copy this file to .env and fill in your values.
# Never commit .env — it is gitignored.

# ── Telegram MTProto (https://my.telegram.org/apps) ───────────────────────
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
# Set to "false" to block all three Telegram tools (download, download_by_ids, search).
# MCP users have no way to override this — it is server-side only.
TELEGRAM_TOOLS_ENABLED=true

# ── Google OAuth2 (https://console.cloud.google.com/apis/credentials) ─────
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
GOOGLE_REFRESH_TOKEN=your_refresh_token
GOOGLE_ACCESS_TOKEN=your_access_token

# ── Google Cloud TTS voice settings ───────────────────────────────────────
GOOGLE_TTS_VOICE=en-US-Neural2-A
GOOGLE_TTS_LANGUAGE_CODE=en-US

# ── Groq API (https://console.groq.com/keys) ──────────────────────────────
GROQ_API_KEY=your_groq_api_key

# ── ChromaDB — runtime config, not secrets ────────────────────────────────
# These control where chroma_service.py and the MCP tools connect.
# Change only if you run ChromaDB on a non-default host/port.
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
CHROMA_EMBEDDING_MODEL=all-MiniLM-L6-v2
